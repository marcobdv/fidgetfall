<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SampleClockwork</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Tests live in their own project (test/SampleClockwork.Tests.csproj) so the
         test framework never ships with an exported game. -->
    <Compile Remove="test/**/*.cs" />
    <InternalsVisibleTo Include="SampleClockwork.Tests" />
  </ItemGroup>
</Project>
