; Engine configuration file for Clockwork Menagerie.
; Follows the Fidgetfall studio conventions (mirrors the verified sample-clockwork).
; The Gameplay Programmer authors scenes/Main.tscn; this file only points at it.

config_version=5

[application]

config/name="Clockwork Menagerie"
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[dotnet]

project/assembly_name="ClockworkMenagerie"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

; The single context-sensitive verb (repair.md §2, GDD §7). Left mouse button is the
; primary binding; the E key is a convenience alias so the action is reachable without
; the mouse during testing. Logic must reference the action NAME, never raw keycodes.
interact={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1,"pressed":false,"double_click":false,"canceled":false,"script":null), Object(InputEventKey,"physical_keycode":69,"unicode":0,"script":null)]
}
; Releases a grabbed part back to its rest position (re-seat safety net, repair.md OQ2).
; Right mouse button + Esc.
cancel={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2,"pressed":false,"double_click":false,"canceled":false,"script":null), Object(InputEventKey,"physical_keycode":4194305,"unicode":0,"script":null)]
}

[rendering]

renderer/rendering_method="forward_plus"
