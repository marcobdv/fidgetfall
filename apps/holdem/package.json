{
  "name": "@fidgetfall/holdem",
  "version": "0.1.0",
  "private": true,
  "description": "Online no-limit Texas Hold'em for humans and AI agents, with a poker coach and an MCP seat.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "holdem-mcp": "./dist/mcp/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types --watch src/server/main.ts",
    "start": "node dist/server/main.js",
    "mcp:stdio": "node dist/mcp/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
